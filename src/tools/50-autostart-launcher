#!/bin/sh
# ==============================================================================
# Auto-Start & Power-On Watcher for vn.hungvu.tvlauncher
# Handles: Cold Boot, Standby/Suspend Resume, LG Home Suppression
# ==============================================================================
APP_ID="vn.hungvu.tvlauncher"
LOG="/tmp/autostart-launcher.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [launcher] $*" >> "$LOG"
}

launch_app() {
    log "Launching $APP_ID..."
    luna-send -n 1 luna://com.webos.applicationManager/launch "{\"id\":\"$APP_ID\",\"keepAlive\":true}" >> "$LOG" 2>&1
}

# 1. COLD BOOT: Wait for SAM / WebAppMgr to be ready and launch with retry
(
    retries=0
    max_retries=30
    log "Cold boot start sequence initiated..."
    while [ "$retries" -lt "$max_retries" ]; do
        sleep 2
        retries=$((retries + 1))
        res=$(luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null)
        if echo "$res" | grep -q '"returnValue":true'; then
            log "SAM ready on attempt $retries. Launching launcher..."
            launch_app
            break
        fi
    done
) &

# 2. STANDBY / POWER RESUME: Listen for TV power state transitions to Active
(
    last_state="Active"
    log "Starting Power State Watcher..."
    luna-send -i luna://com.webos.service.tvpower/power/getPowerState '{"subscribe":true}' 2>/dev/null | while read -r line; do
        state=$(echo "$line" | grep -o '"state": *"[^"]*"' | cut -d'"' -f4)
        if [ -n "$state" ]; then
            if [ "$state" = "Active" ] && [ "$last_state" != "Active" ]; then
                log "Power resumed: $last_state -> Active. Bringing launcher to front..."
                sleep 0.8
                launch_app
            fi
            last_state="$state"
        fi
    done
) &

# 3. LG HOME SUPPRESSION: Catch com.webos.app.home and immediately replace with our launcher
(
    log "Starting Foreground Watcher LG Home suppression..."
    luna-send -i luna://com.webos.applicationManager/getForegroundAppInfo '{"subscribe":true}' 2>/dev/null | while read -r line; do
        fg=$(echo "$line" | grep -o '"appId": *"[^"]*"' | cut -d'"' -f4)
        if [ "$fg" = "com.webos.app.home" ]; then
            log "Detected LG Home com.webos.app.home. Suppressing and launching $APP_ID..."
            launch_app
        fi
    done
) &
